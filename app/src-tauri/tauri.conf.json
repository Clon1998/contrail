{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contrail",
  "mainBinaryName": "contrail",
  "version": "0.1.0",
  "identifier": "io.github.clon1998.contrail",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Contrail",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1Rjk1OEQ1NDE5RDk2NzQKUldSMGxwMUIxVmo1SlErU0lSUElRMHp0bkxyY1F6WUJtRURuOTlxalMzaFk4dG5KbTlMeE5uVHIK",
      "endpoints": [
        "https://github.com/Clon1998/contrail/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "contrail"
        ]
      }
    }
  }
}
