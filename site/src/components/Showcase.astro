---
/**
 * A landing page section: text on one side (under a `// eyebrow` label, see custom.css), a
 * picture or code (the `media` slot) on the other.
 * Stacks on narrow screens; `flip` puts the media first on wide ones.
 */
interface Props {
  eyebrow: string;
  title: string;
  flip?: boolean;
}

const { eyebrow, title, flip = false } = Astro.props;
---

<section class:list={["showcase not-content", { flip }]}>
  <div class="text">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <slot />
  </div>
  <div class="media"><slot name="media" /></div>
</section>

<style>
  .showcase {
    display: grid;
    /* minmax(0, …): wide code blocks scroll instead of widening the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    padding-block: 4rem;
  }
  .showcase + .showcase {
    border-top: 1px solid var(--sl-color-hairline);
  }
  @media (min-width: 64rem) {
    .showcase {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 3rem;
    }
    .flip {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
    .flip .text {
      order: 2;
    }
  }
  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    line-height: 1.1;
    color: var(--sl-color-white);
  }
  .text :global(p) {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-2);
  }
  .text :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--sl-color-gray-2);
  }
  .text :global(li)::before {
    content: "→ ";
    font-family: var(--sl-font-mono);
    color: var(--sl-color-text-accent);
  }
  .text :global(li + li) {
    margin-top: 0.4rem;
  }
  .text :global(code) {
    font-size: 0.9em;
  }
  .media > :global(div) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }
</style>
