---
/**
 * An app screenshot in a window frame, light or dark to match the site's theme. The pictures
 * come from `pnpm screenshots` in app/ui (src/assets/screenshots/<name>-<light|dark>.png).
 */
import { Image } from "astro:assets";

interface Props {
  name: string;
  alt: string;
  /** Shown in the window's title bar, e.g. the service in the picture. */
  title?: string;
  /** Loaded right away (the first screenshot on the page) instead of lazily. */
  eager?: boolean;
}

const { name, alt, title = "contrail", eager = false } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png");
const load = async (scheme: string) => {
  const key = `../assets/screenshots/${name}-${scheme}.png`;
  if (!shots[key]) throw new Error(`missing screenshot ${key} (run pnpm screenshots in app/ui)`);
  return (await shots[key]()).default;
};
const [light, dark] = await Promise.all([load("light"), load("dark")]);
const attrs = {
  alt,
  widths: [640, 1280, 1920],
  sizes: "(min-width: 76rem) 76rem, 100vw",
  loading: eager ? ("eager" as const) : ("lazy" as const),
};
---

<figure class="window not-content">
  <div class="titlebar" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="M4 19 C 9 16, 13 11, 19 5"></path><path d="M7 21 C 12 18, 16 13, 21 7"></path></svg>
    {title}
  </div>
  <Image src={light} {...attrs} class="light" />
  <Image src={dark} {...attrs} class="dark" />
</figure>

<style>
  .window {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--ct-radius);
    overflow: hidden;
    background: var(--sl-color-bg);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 40px 90px -30px color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .titlebar svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Starlight sets data-theme on <html> before the page renders, so this never flickers. */
  :global([data-theme="light"]) .dark,
  :global([data-theme="dark"]) .light {
    display: none;
  }
</style>
